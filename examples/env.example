# Modèle : à copier en .env.example DANS LE DÉPÔT DU PROJET (commité, sans valeurs).
# La vraie version vit sur le VPS : /opt/vlldnt/config/<nom>.env  (chmod 600, hors Git).
# Jamais de secret dans le dépôt, jamais dans les fichiers nginx.

NODE_ENV=production
PORT=3000
DATABASE_URL=postgres://monprojet:CHANGEME@db:5432/monprojet
