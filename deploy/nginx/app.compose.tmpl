# GÉNÉRÉ par deploy-project.sh — NE PAS ÉDITER
# Application conteneurisée @@NAME@@ → https://@@NAME@@.vlldnt.fr
# Le conteneur écoute UNIQUEMENT sur 127.0.0.1:@@PORT@@ ; nginx est le
# seul point d'entrée public. Certificat wildcard mutualisé.

server {
    listen 80;
    listen [::]:80;
    server_name @@NAME@@.vlldnt.fr;
    location / { return 301 https://@@NAME@@.vlldnt.fr$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name @@NAME@@.vlldnt.fr;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/vlldnt.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vlldnt.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 25m;

    include /opt/vlldnt/nginx/snippets/security-headers.conf;
    add_header Content-Security-Policy "@@CSP@@" always;

    location / {
        include /opt/vlldnt/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "@@CSP@@" always;

        proxy_pass http://127.0.0.1:@@PORT@@;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_read_timeout 60s;
    }
}
