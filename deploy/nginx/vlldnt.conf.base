# /opt/vlldnt/nginx/vlldnt.conf
# Vhost APEX du domaine. Lié depuis /etc/nginx/sites-enabled/vlldnt.conf
# (symlink posé une fois par VPS-BOOTSTRAP.md). Modifié via le repo portfolio
# (deploy/nginx/vlldnt.conf.base) + deploy-portfolio.sh.
#
# Les blocs des sous-domaines projets et des landings sont générés dans
#   /opt/vlldnt/nginx/generated/apps/*.conf      (blocs server complets)
#   /opt/vlldnt/nginx/generated/landings/*.conf  (blocs location, inclus ci-dessous)

# --- HTTP : redirection vers HTTPS -------------------------------------
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name vlldnt.fr www.vlldnt.fr;
    location / { return 301 https://vlldnt.fr$request_uri; }
}

# --- HTTPS : www -> apex --------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.vlldnt.fr;
    ssl_certificate     /etc/letsencrypt/live/vlldnt.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vlldnt.fr/privkey.pem;
    return 301 https://vlldnt.fr$request_uri;
}

# --- HTTPS : le portfolio ------------------------------------------
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name vlldnt.fr;
    server_tokens off;

    ssl_certificate     /etc/letsencrypt/live/vlldnt.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vlldnt.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    error_page 404 /404.html;

    include /opt/vlldnt/nginx/snippets/security-headers.conf;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;

    # Landing pages des projets (fragments générés).
    include /opt/vlldnt/nginx/generated/landings/*.conf;

    # Conteneur du portfolio (nginx+dist Astro, port loopback — cf. compose.yml).
    # Cache/gzip déjà gérés dans le conteneur (deploy/nginx/portfolio.conf) ; ici
    # on ne fait que proxy_pass + en-têtes de sécurité/CSP.
    location / {
        include /opt/vlldnt/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'" always;
        proxy_pass http://127.0.0.1:8086;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# --- Sous-domaines des projets (blocs server générés) --------------
include /opt/vlldnt/nginx/generated/apps/*.conf;
