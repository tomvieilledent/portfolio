---
import { parse } from "yaml";
import { readFileSync, existsSync } from "node:fs";
import { fileURLToPath } from "node:url";

const cfg = parse(readFileSync(new URL("../../projects.yml", import.meta.url), "utf8"));

// Illustration d'une carte : projects/<name>/landing-page/portfolio.png, si le
// dépôt du projet en fournit une. Elle est déjà publiée par la landing, donc
// servie telle quelle sous vlldnt.fr/<name>/portfolio.png — on ne la copie pas.
// Les chemins candidats couvrent le repo local et l'arbo VPS (/opt/vlldnt).
const pfRoot = new URL("../../", import.meta.url);
const coverFor = (name) => {
  const rels = [
    `../projects/${name}/landing-page/portfolio.png`,        // repo local (vlldnt.fr/projects/<name>/)
    `../projects/${name}/src/landing-page/portfolio.png`,    // VPS : /opt/vlldnt/projects/<name>/src/
    `../../projects/${name}/landing-page/portfolio.png`,
    `../../projects/${name}/src/landing-page/portfolio.png`,
    `../landing-pages/${name}/portfolio.png`,                // VPS : landing déjà publiée
    `../../landing-pages/${name}/portfolio.png`,
  ];
  return rels.some((r) => existsSync(fileURLToPath(new URL(r, pfRoot))))
    ? `/${name}/portfolio.png`
    : "";
};

const projects = (cfg.projects ?? [])
  .filter((p) => p.deployed === true)
  .map((p) => ({
    name: p.name,
    title: p.title ?? p.name,
    tagline: p.tagline ?? "",
    stack: p.stack ?? "",
    role: p.role ?? "",
    logo: p.logo ?? "",
    cover: coverFor(p.name),
    wip: p.wip === true,
    repo: String(p.repo || "").replace(/^https:\/\/github\.com\//, "").replace(/\.git$/, ""),
    landing: `/${p.name}/`,
    app: `https://${p.name}.vlldnt.fr`,
  }));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Tom Vieilledent — développeur fullstack indépendant. Applications web sur mesure, hébergées sur infrastructure propre." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://vlldnt.fr/" />
    <meta name="theme-color" content="#0B1220" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vlldnt.fr/" />
    <meta property="og:title" content="Tom Vieilledent — Vieilledent Conseil" />
    <meta property="og:description" content="Développeur fullstack indépendant. Applications web sur mesure." />
    <meta property="og:image" content="https://vlldnt.fr/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="https://vlldnt.fr/og.jpg" />
    <title>Tom Vieilledent — développeur fullstack</title>
  </head>
  <body>
    <div class="page">
      <header class="masthead">
        <img src="/logo.png" width="600" height="600" alt="Vieilledent Conseil — Tom Vieilledent, développeur full stack" />
      </header>

      <section class="intro">
        <p>
          Je développe des applications web sur mesure — de la conception
          de l'interface au déploiement — et je les héberge moi-même sur un
          serveur dédié : nginx, HTTPS, intégration et déploiement continus.
        </p>
        <p class="links">
          <a href="mailto:tomvieilledent@gmail.com">tomvieilledent@gmail.com</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/tomvieilledent">github.com/tomvieilledent</a>
        </p>
      </section>

      <section class="works" aria-label="Réalisations en ligne">
        <h2>Réalisations en ligne</h2>
        <ol>
          {projects.map((p, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <div class="work">
                <div class="work-title">
                  {p.logo && <img src={p.logo} width="28" height="28" alt="" />}
                  <h3>{p.wip ? p.title : <a href={p.app}>{p.title}</a>}</h3>
                  {p.wip && <span class="tag">En construction</span>}
                </div>
                {p.cover && (
                  <a class="shot" href={p.landing} aria-label={`Aperçu de ${p.title}`}>
                    <img src={p.cover} alt={`Capture d’écran de ${p.title}`} loading="lazy" decoding="async" />
                  </a>
                )}
                {p.tagline && <p class="desc">{p.tagline}</p>}
                <p class="meta">
                  {p.role && <span>{p.role}</span>}
                  {p.stack && <span>{p.stack}</span>}
                </p>
                <p class="work-links">
                  {!p.wip && <a href={p.app}>Site en ligne</a>}
                  <a href={p.landing}>Présentation</a>
                  <a href={`https://github.com/${p.repo}`}>Code source</a>
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <footer>
        Aveyron, France. Site et projets hébergés sur <a href="https://vlldnt.fr">vlldnt.fr</a>.
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    --bg: #0B1220;
    --text: #e6e4df;
    --muted: #9a9a92;
    --faint: #6f6f68;
    --rule: #2a2c33;
    --accent: #7ba0ff;
    color-scheme: dark;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 2px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .page { max-width: 40rem; margin: 0 auto; padding: clamp(40px, 9vw, 88px) 24px clamp(56px, 12vw, 112px); }

  .masthead { text-align: center; }
  .masthead img {
    display: block;
    margin: 0 auto;
    width: clamp(260px, 72vw, 400px);
    height: auto;
    border-radius: 16px;
  }

  .intro { margin-top: clamp(28px, 6vw, 44px); }
  .intro p { margin: 0; max-width: 34rem; }
  .intro .links { margin-top: 16px; font-size: 0.92rem; color: var(--faint); display: flex; gap: 10px; flex-wrap: wrap; }

  .works { margin-top: clamp(48px, 11vw, 80px); }
  .works h2 {
    margin: 0 0 16px;
    font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--faint);
  }
  .works ol {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .works li {
    display: flex;
    flex-direction: column;
    padding: 20px;
    border: 1px solid var(--rule);
    border-radius: 12px;
  }
  .num { font-family: var(--mono); font-size: 0.82rem; color: var(--faint); margin-bottom: 6px; }

  /* Format PC : au moins deux colonnes, section élargie hors de la colonne de lecture. */
  @media (min-width: 760px) {
    .works {
      width: min(52rem, 92vw);
      margin-left: 50%;
      transform: translateX(-50%);
    }
    .works ol { grid-template-columns: repeat(2, 1fr); }
  }

  .work-title { display: flex; align-items: center; gap: 9px; }
  .work-title img { border-radius: 5px; flex: none; }
  .work h3 { margin: 0; font-family: var(--serif); font-size: 1.25rem; font-weight: 600; letter-spacing: -0.01em; }
  .work h3 a { color: var(--text); }
  .work h3 a:hover { color: var(--accent); text-decoration: none; }

  .shot {
    display: block;
    margin: 14px 0 2px;
    border: 1px solid var(--rule);
    border-radius: 10px;
    overflow: hidden;
    background: var(--rule);
  }
  .shot img { display: block; width: 100%; height: auto; }
  .shot:hover { border-color: var(--muted); }

  .desc { margin: 10px 0 0; color: var(--muted); max-width: 32rem; }
  .meta {
    margin: 12px 0 0;
    font-family: var(--mono); font-size: 0.8rem; color: var(--faint);
    display: flex; flex-direction: column; gap: 2px;
  }
  .work-links { margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 0.9rem; }

  footer {
    margin-top: clamp(48px, 11vw, 80px);
    color: var(--faint); font-size: 0.85rem;
  }

  @media (max-width: 460px) {
    .num { display: none; }
  }
</style>
