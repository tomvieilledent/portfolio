---
import { parse } from "yaml";
import { readFileSync } from "node:fs";

const cfg = parse(readFileSync(new URL("../../projects.yml", import.meta.url), "utf8"));

// Illustration d'une carte : projects/<name>/landing-page/portfolio.png, publiée
// par la landing du projet et servie telle quelle sous vlldnt.fr/<name>/portfolio.png
// par nginx (indépendamment du conteneur portfolio — pas de vérification d'existence
// possible ici : le build tourne dans un conteneur isolé, sans accès aux autres dépôts).
const coverFor = (name) => `/${name}/portfolio.png`;

const projects = (cfg.projects ?? [])
  // `public: false` = déployé (vhost + conteneur) mais pas une vitrine (ex. une API
  // backend d'un autre projet) : absent de la page d'accueil.
  .filter((p) => p.deployed === true && p.public !== false)
  .map((p) => ({
    name: p.name,
    title: p.title ?? p.name,
    tagline: p.tagline ?? "",
    stack: p.stack ?? "",
    role: p.role ?? "",
    logo: p.logo ?? "",
    cover: coverFor(p.name),
    wip: p.wip === true,
    // `source: false` = pas de lien « Code source » (projet client, dépôt non public).
    source: p.source !== false,
    repo: String(p.repo || "").replace(/^https:\/\/github\.com\//, "").replace(/\.git$/, ""),
    landing: `/${p.name}/`,
  }));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Tom Vieilledent — développeur fullstack indépendant. Applications web sur mesure, hébergées sur infrastructure propre." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://vlldnt.fr/" />
    <meta name="theme-color" content="#0B111D" />
    <script is:inline src="/theme.js"></script>
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vlldnt.fr/" />
    <meta property="og:title" content="Tom Vieilledent — Vieilledent Conseil" />
    <meta property="og:description" content="Développeur fullstack indépendant. Applications web sur mesure." />
    <meta property="og:image" content="https://vlldnt.fr/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="https://vlldnt.fr/og.jpg" />
    <title>Tom Vieilledent — développeur fullstack</title>
  </head>
  <body>
    <button id="theme-toggle" type="button" hidden aria-label="Changer de thème">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M12 3v2M12 19v2M5 5l1.5 1.5M17.5 17.5L19 19M3 12h2M19 12h2M5 19l1.5-1.5M17.5 6.5L19 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>

    <header class="hero">
      <div class="wrap hero-grid">
        <div class="hero-text">
          <p class="kicker">Vieilledent Conseil</p>
          <h1>Tom Vieilledent</h1>
          <p class="role">Développeur full stack indépendant</p>
          <p class="pitch">
            Je développe des applications web sur mesure — de la conception de
            l'interface au déploiement — et je les héberge moi-même sur un serveur
            dédié : nginx, HTTPS, intégration et déploiement continus.
          </p>
          <p class="cta">
            <a class="btn primary" href="mailto:tomvieilledent@gmail.com">Me contacter</a>
            <a class="btn ghost" href="https://github.com/tomvieilledent">GitHub</a>
          </p>
        </div>
        <img
          class="hero-logo"
          src="/logo.png"
          width="600"
          height="600"
          alt="Vieilledent Conseil — développeur full stack"
        />
      </div>
    </header>

    <main>
      <section class="works wrap" aria-labelledby="works-title">
        <div class="section-head">
          <h2 id="works-title">Réalisations</h2>
          <p>{projects.length} projets en ligne ou en cours de construction</p>
        </div>
        <ol>
          {projects.map((p) => (
            <li>
              <a class="shot" href={p.landing} aria-label={`Voir le projet ${p.title}`} tabindex="-1">
                <img src={p.cover} alt={`Aperçu de ${p.title}`} loading="lazy" decoding="async" />
              </a>
              <div class="work">
                <div class="work-title">
                  <h3><a href={p.landing}>{p.title}</a></h3>
                  {p.wip && <span class="tag">En construction</span>}
                </div>
                {p.tagline && <p class="desc">{p.tagline}</p>}
                {p.role && <p class="role-line">{p.role}</p>}
                {p.stack && (
                  <ul class="stack" aria-label="Technologies">
                    {p.stack.split("·").map((t) => <li>{t.trim()}</li>)}
                  </ul>
                )}
                <p class="work-links">
                  <a href={p.landing}>Voir le projet <span aria-hidden="true">→</span></a>
                  {p.source && <a class="quiet" href={`https://github.com/${p.repo}`}>Code source</a>}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    </main>

    <footer>
      <div class="wrap foot">
        <p>© Vieilledent Conseil — Aveyron, France.</p>
        <p>
          <a href="mailto:tomvieilledent@gmail.com">tomvieilledent@gmail.com</a>
          <span aria-hidden="true"> · </span>
          <a href="https://github.com/tomvieilledent">GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Identité tirée du logo : marine #0B111D, bleu #3E87E0, blanc.
     Le bandeau d'en-tête reste marine dans les deux thèmes ; le reste suit
     le thème (clair par défaut, sombre via préférence système ou bouton). */
  :root {
    --navy: #0B111D;
    --navy-2: #121A2B;
    --bg: #F4F6F9;
    --card: #FFFFFF;
    --text: #0B111D;
    --muted: #536074;
    --rule: #DFE5ED;
    --accent: #2563B8;
    --accent-ink: #FFFFFF;
    --blue: #3E87E0;
    --shadow: 0 1px 2px rgba(11, 17, 29, 0.06), 0 8px 24px -12px rgba(11, 17, 29, 0.18);
    color-scheme: light;
    --sans: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      --bg: #0E1524; --card: #131C2E; --text: #E8EDF5; --muted: #9AA7BC; --rule: #1F2A40;
      --accent: #5B9BEA; --accent-ink: #0B111D; --shadow: 0 1px 2px rgba(0,0,0,.3); color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #0E1524; --card: #131C2E; --text: #E8EDF5; --muted: #9AA7BC; --rule: #1F2A40;
    --accent: #5B9BEA; --accent-ink: #0B111D; --shadow: 0 1px 2px rgba(0,0,0,.3); color-scheme: dark;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font-family: var(--sans); font-size: 16px; line-height: 1.65;
    -webkit-font-smoothing: antialiased;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 3px; }
  :focus-visible { outline: 2px solid var(--blue); outline-offset: 3px; border-radius: 4px; }
  .wrap { width: 100%; max-width: 64rem; margin: 0 auto; padding: 0 24px; }

  #theme-toggle {
    position: fixed; top: 16px; right: 16px; z-index: 20;
    width: 38px; height: 38px; display: grid; place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.22); border-radius: 10px;
    background: rgba(11, 17, 29, 0.55); color: #cfd8e6; cursor: pointer;
    backdrop-filter: blur(6px);
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  #theme-toggle:hover { color: #fff; border-color: rgba(255, 255, 255, 0.5); }
  #theme-toggle svg { width: 18px; height: 18px; }
  #theme-toggle .i-sun { display: none; }
  #theme-toggle[data-theme="dark"] .i-sun { display: block; }
  #theme-toggle[data-theme="dark"] .i-moon { display: none; }

  /* ---------- En-tête (toujours marine) ---------- */
  .hero { background: var(--navy); color: #E8EDF5; }
  .hero-grid {
    display: grid; align-items: center; gap: 24px;
    grid-template-columns: 1fr;
    padding-top: clamp(48px, 8vw, 88px); padding-bottom: clamp(40px, 7vw, 80px);
  }
  .hero-logo { width: clamp(180px, 46vw, 300px); height: auto; justify-self: center; order: -1; border-radius: 12px; }
  .kicker { margin: 0; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--blue); }
  .hero h1 { margin: 10px 0 0; font-size: clamp(2.2rem, 6vw, 3.4rem); line-height: 1.08; letter-spacing: -0.025em; font-weight: 700; color: #fff; }
  .role { margin: 8px 0 0; font-size: clamp(1.05rem, 2.4vw, 1.25rem); color: #AFC3E0; }
  .pitch { margin: 20px 0 0; max-width: 34rem; color: #C3CCDB; }
  .cta { margin: 28px 0 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .btn {
    display: inline-block; padding: 11px 22px; border-radius: 10px; font-weight: 600; font-size: 0.95rem;
    border: 1px solid transparent; transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn:hover { text-decoration: none; }
  .btn.primary { background: var(--blue); color: #fff; }
  .btn.primary:hover { background: #5A9BE8; }
  .btn.ghost { color: #E8EDF5; border-color: rgba(255, 255, 255, 0.3); }
  .btn.ghost:hover { border-color: rgba(255, 255, 255, 0.6); }

  @media (min-width: 820px) {
    .hero-grid { grid-template-columns: 1.15fr 0.85fr; gap: 56px; }
    .hero-logo { order: 0; justify-self: end; width: min(100%, 340px); }
  }

  /* ---------- Réalisations ---------- */
  .works { padding-top: clamp(40px, 7vw, 72px); padding-bottom: clamp(48px, 8vw, 88px); }
  .section-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 16px; margin-bottom: 24px; }
  .section-head h2 { margin: 0; font-size: clamp(1.4rem, 3.4vw, 1.8rem); letter-spacing: -0.02em; }
  .section-head p { margin: 0; color: var(--muted); font-size: 0.92rem; }
  .works ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 22px; }
  @media (min-width: 760px) { .works ol { grid-template-columns: repeat(2, 1fr); gap: 26px; } }

  .works li {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--card); border: 1px solid var(--rule); border-radius: 14px; box-shadow: var(--shadow);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .works li:hover { transform: translateY(-3px); border-color: var(--blue); }
  .shot { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--rule); border-bottom: 1px solid var(--rule); }
  .shot img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }

  .work { display: flex; flex-direction: column; flex: 1; padding: 20px 22px 22px; }
  .work-title { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 10px; }
  .work h3 { margin: 0; font-size: 1.2rem; letter-spacing: -0.015em; font-weight: 650; }
  .work h3 a { color: var(--text); }
  .work h3 a:hover { color: var(--accent); text-decoration: none; }
  .tag {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--accent); border: 1px solid currentColor; border-radius: 999px; padding: 2px 9px; white-space: nowrap;
  }
  .desc { margin: 10px 0 0; color: var(--muted); font-size: 0.97rem; }
  .role-line { margin: 10px 0 0; font-size: 0.85rem; color: var(--muted); }
  .stack { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .stack li {
    padding: 2px 10px; font-size: 0.78rem; font-weight: 500; color: var(--text);
    background: var(--bg); border: 1px solid var(--rule); border-radius: 999px;
    box-shadow: none; transform: none; display: block;
  }
  .stack li:hover { transform: none; border-color: var(--rule); }
  .work-links { margin: auto 0 0; padding-top: 18px; display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 0.92rem; font-weight: 600; }
  .work-links .quiet { margin-left: auto; font-weight: 500; color: var(--muted); }

  /* ---------- Pied de page ---------- */
  footer { background: var(--navy); color: #AFC0D8; font-size: 0.88rem; }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; padding-top: 24px; padding-bottom: 28px; }
  .foot p { margin: 0; }
  footer a { color: #D6E2F5; }

  @media (prefers-reduced-motion: reduce) { .works li, .works li:hover { transition: none; transform: none; } }
</style>
