---
import { parse } from "yaml";
import { readFileSync } from "node:fs";

const cfg = parse(readFileSync(new URL("../../projects.yml", import.meta.url), "utf8"));
const projects = (cfg.projects ?? [])
  .filter((p) => p.deployed === true)
  .map((p) => ({
    name: p.name,
    title: p.title ?? p.name,
    tagline: p.tagline ?? "",
    stack: p.stack ?? "",
    role: p.role ?? "",
    logo: p.logo ?? "",
    repo: String(p.repo || "").replace(/^https:\/\/github\.com\//, "").replace(/\.git$/, ""),
    landing: `/${p.name}/`,
    app: `https://${p.name}.vlldnt.fr`,
  }));
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Tom Vieilledent — développeur fullstack indépendant. Applications web sur mesure, hébergées sur infrastructure propre." />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://vlldnt.fr/" />
    <meta name="theme-color" content="#0d1b2e" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#faf9f7" media="(prefers-color-scheme: light)" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vlldnt.fr/" />
    <meta property="og:title" content="Tom Vieilledent — Vieilledent Conseil" />
    <meta property="og:description" content="Développeur fullstack indépendant. Applications web sur mesure." />
    <meta property="og:image" content="https://vlldnt.fr/og.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:image" content="https://vlldnt.fr/og.jpg" />
    <script is:inline src="/theme.js"></script>
    <title>Tom Vieilledent — développeur fullstack</title>
  </head>
  <body>
    <button id="theme-toggle" type="button" hidden aria-label="Changer de thème">
      <svg class="i-moon" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
      <svg class="i-sun" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M12 3v2M12 19v2M5 5l1.5 1.5M17.5 17.5L19 19M3 12h2M19 12h2M5 19l1.5-1.5M17.5 6.5L19 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <svg class="i-auto" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8" stroke="currentColor" stroke-width="1.6"/><path d="M12 4v16A8 8 0 0 0 12 4Z" fill="currentColor"/></svg>
    </button>

    <div class="page">
      <header class="masthead">
        <img src="/logo.png" width="600" height="600" alt="Vieilledent Conseil — Tom Vieilledent, développeur full stack" />
        <p class="name">Tom Vieilledent</p>
      </header>

      <section class="intro">
        <p>
          Je développe des applications web sur mesure — de la conception
          de l'interface au déploiement — et je les héberge moi-même sur un
          serveur dédié : nginx, HTTPS, intégration et déploiement continus.
        </p>
        <p class="links">
          <a href="mailto:tomvieilledent@gmail.com">tomvieilledent@gmail.com</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/tomvieilledent">github.com/tomvieilledent</a>
        </p>
      </section>

      <section class="works" aria-label="Réalisations en ligne">
        <h2>Réalisations en ligne</h2>
        <ol>
          {projects.map((p, i) => (
            <li>
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <div class="work">
                <div class="work-title">
                  {p.logo && <img src={p.logo} width="22" height="22" alt="" />}
                  <h3><a href={p.app}>{p.title}</a></h3>
                </div>
                {p.tagline && <p class="desc">{p.tagline}</p>}
                <p class="meta">
                  {p.role && <span>{p.role}</span>}
                  {p.stack && <span>{p.stack}</span>}
                </p>
                <p class="work-links">
                  <a href={p.app}>Site en ligne</a>
                  <a href={p.landing}>Présentation</a>
                  <a href={`https://github.com/${p.repo}`}>Code source</a>
                </p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <footer>
        Aveyron, France. Site et projets hébergés sur <a href="https://vlldnt.fr">vlldnt.fr</a>.
      </footer>
    </div>
  </body>
</html>

<style>
  :root {
    --bg: #faf9f7;
    --text: #1a1a1a;
    --muted: #6b6b6b;
    --faint: #9a9a94;
    --rule: #e2e0da;
    --accent: #1d4ed8;
    color-scheme: light;
    --serif: "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, "Times New Roman", serif;
    --sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) {
      --bg: #12141a; --text: #e6e4df; --muted: #9a9a92; --faint: #6f6f68;
      --rule: #2a2c33; --accent: #7ba0ff;
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"] {
    --bg: #12141a; --text: #e6e4df; --muted: #9a9a92; --faint: #6f6f68;
    --rule: #2a2c33; --accent: #7ba0ff; color-scheme: dark;
  }
  :root[data-theme="light"] {
    --bg: #faf9f7; --text: #1a1a1a; --muted: #6b6b6b; --faint: #9a9a94;
    --rule: #e2e0da; --accent: #1d4ed8; color-scheme: light;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 2px; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .page { max-width: 40rem; margin: 0 auto; padding: clamp(40px, 9vw, 88px) 24px clamp(56px, 12vw, 112px); }

  #theme-toggle {
    position: fixed; top: 16px; right: 16px; z-index: 10;
    width: 34px; height: 34px; display: grid; place-items: center;
    border: 1px solid var(--rule); border-radius: 8px;
    background: transparent; color: var(--faint); cursor: pointer;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  #theme-toggle:hover { color: var(--text); border-color: var(--muted); }
  #theme-toggle svg { width: 17px; height: 17px; }
  #theme-toggle .i-sun, #theme-toggle .i-auto { display: none; }
  #theme-toggle[data-state="light"] .i-sun { display: block; }
  #theme-toggle[data-state="light"] .i-moon { display: none; }
  #theme-toggle[data-state="auto"] .i-auto { display: block; }
  #theme-toggle[data-state="auto"] .i-moon { display: none; }

  .masthead { }
  .masthead img {
    display: block;
    width: clamp(180px, 46vw, 264px);
    height: auto;
    border-radius: 16px;
  }
  .masthead .name {
    margin: 18px 0 0;
    font-family: var(--serif);
    font-size: 1.3rem;
    letter-spacing: -0.01em;
  }

  .intro { margin-top: clamp(28px, 6vw, 44px); }
  .intro p { margin: 0; max-width: 34rem; }
  .intro .links { margin-top: 16px; font-size: 0.92rem; color: var(--faint); display: flex; gap: 10px; flex-wrap: wrap; }

  .works { margin-top: clamp(48px, 11vw, 80px); }
  .works h2 {
    margin: 0 0 8px;
    font-size: 0.78rem; font-weight: 600;
    letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--faint);
  }
  .works ol { list-style: none; margin: 0; padding: 0; }
  .works li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 4px 0;
    padding: 26px 0;
    border-top: 1px solid var(--rule);
  }
  .works li:last-child { border-bottom: 1px solid var(--rule); }
  .num { font-family: var(--mono); font-size: 0.82rem; color: var(--faint); padding-top: 5px; }

  .work-title { display: flex; align-items: center; gap: 9px; }
  .work-title img { border-radius: 5px; flex: none; }
  .work h3 { margin: 0; font-family: var(--serif); font-size: 1.4rem; font-weight: 600; letter-spacing: -0.01em; }
  .work h3 a { color: var(--text); }
  .work h3 a:hover { color: var(--accent); text-decoration: none; }

  .desc { margin: 10px 0 0; color: var(--muted); max-width: 32rem; }
  .meta {
    margin: 12px 0 0;
    font-family: var(--mono); font-size: 0.8rem; color: var(--faint);
    display: flex; flex-direction: column; gap: 2px;
  }
  .work-links { margin: 16px 0 0; display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 0.9rem; }

  footer {
    margin-top: clamp(48px, 11vw, 80px);
    color: var(--faint); font-size: 0.85rem;
  }

  @media (max-width: 460px) {
    .works li { grid-template-columns: 1fr; }
    .num { display: none; }
  }
</style>
